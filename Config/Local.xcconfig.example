// Copy to Config/Local.xcconfig (git-ignored) and set your Apple development team ID.
// Find it in Xcode > Settings > Accounts, or with:  security find-identity -v -p codesigning
DEVELOPMENT_TEAM = XXXXXXXXXX
CODE_SIGN_STYLE = Automatic
CODE_SIGNING_ALLOWED = YES
CODE_SIGNING_REQUIRED = YES

// Backup to an S3-compatible bucket you run, for example Cloudflare R2. Create the bucket and
// an API token limited to object read and write on that one bucket. The keys are compiled into
// the app and can be read out of it, so use this for your own builds only.
// The host has no "https://" in front: "//" starts a comment in this file.
// S3_BACKUP_HOST = <account id>.r2.cloudflarestorage.com
// S3_BACKUP_REGION = auto
// S3_BACKUP_BUCKET = tactile-texts-backups
// S3_BACKUP_ACCESS_KEY_ID = xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
// S3_BACKUP_SECRET_ACCESS_KEY = xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
// Optional: a key prefix inside the bucket, and the name the app shows for this destination.
// S3_BACKUP_PREFIX = ipad
// S3_BACKUP_NAME = Cloudflare R2

// The Tactile Texts cloud backup service (paid backups, encrypted on the iPad). Both values are
// needed and neither is a secret. The host has no scheme ("//" starts a comment in this file):
// a loopback host (localhost, 127.0.0.1, [::1]) is reached over plain HTTP, for a local
// `wrangler dev` of Backend/backup-worker; any other host over HTTPS. The product IDs are the
// auto-renewable subscriptions in App Store Connect, comma-separated; in the simulator the
// scheme's StoreKit configuration (Config/TactileTexts.storekit) sells them with no App Store account.
// App Attest needs no entitlement for development builds (they use Apple's sandbox servers).
// BACKUP_SERVICE_HOST = localhost:8787
// BACKUP_PRODUCT_IDS = software.tactile.texts.backup.standard
// Development only: the simulator has no App Attest, so against a local or `dev` Worker it sends
// this value (the Worker's APP_ATTEST_BYPASS_SECRET in Backend/backup-worker/.dev.vars) instead.
// A debug build with it set sends it on a real device too, instead of App Attest.
// Debug builds only; it is readable in the built app. Never with the production Worker.
// BACKUP_SERVICE_ATTEST_BYPASS = <the dev Worker's APP_ATTEST_BYPASS_SECRET>
// Signing in to Tactile Texts Cloud. Sign in with Apple needs a paid team whose App ID has the
// capability, and the committed entitlements file holding only that entitlement:
// TACTILE_ENTITLEMENTS = Config/SignInWithApple.entitlements
// SIGN_IN_WITH_APPLE = YES
// Sign in with Google: an iOS OAuth client in Google Cloud (bundle ID software.tactile.texts),
// identity only. Its client ID, and the reversed client ID as the redirect's URL scheme.
// GOOGLE_SIGNIN_CLIENT_ID = 123456789012-abcdefghijklmnopqrstuvwxyz012345.apps.googleusercontent.com
// GOOGLE_SIGNIN_URL_SCHEME = com.googleusercontent.apps.123456789012-abcdefghijklmnopqrstuvwxyz012345
// Development only: sign in from the simulator to a local or `dev` Worker through its test
// issuer (the Worker's DEV_TEST_SIGNIN_SECRET in Backend/backup-worker/.dev.vars). Both buttons
// then use it. Debug builds only; it is readable in the built app. Never with the production Worker.
// BACKUP_SERVICE_DEV_SIGNIN = <the dev Worker's DEV_TEST_SIGNIN_SECRET>
// The named test user dev sign-in signs in as (default "dev"): the same name on every simulator
// or device is the same account. The signed-out Tactile Texts Cloud page can change it too.
// BACKUP_SERVICE_DEV_USER = dev
// scripts/dev-cloud.sh writes all of the development values above (Debug builds only, between
// marked lines, for a local `wrangler dev` or, with --host, the deployed `dev` Worker), and
// scripts/dev-cloud.sh --remove takes them out again. See Backend/backup-worker/README.md,
// "Testing sync in development without Apple, Google or the App Store".
// The Terms of Use and Privacy Policy the subscription offer links to (App Review requires both
// for an auto-renewable subscription). Without "https://" ("//" starts a comment in this file);
// the app adds it. A link left empty is not shown.
// BACKUP_TERMS_URL = example.com/tactile-texts/terms
// BACKUP_PRIVACY_URL = example.com/tactile-texts/privacy
