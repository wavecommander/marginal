// Signing defaults for every target. Simulator builds need no signing, so it is off by default
// and a fresh clone builds without an Apple developer team.
//
// To run on a device, or to build from the Xcode window with signing, copy
// Config/Local.xcconfig.example to Config/Local.xcconfig (git-ignored) and put your team ID in it.
// scripts/device.sh passes the same settings on the command line and needs no local file.
CODE_SIGNING_ALLOWED = NO
CODE_SIGNING_REQUIRED = NO

// Backup integrations that need an account are off unless Config/Local.xcconfig turns them on
// (see Config/Local.xcconfig.example). Empty means off: the app shows the destination as not
// available in this build.
// - MARGINAL_ENTITLEMENTS: the app target's entitlements file. Empty: none, which is what an
//   unsigned simulator build and a free Personal Team need.
// - GOOGLE_DRIVE_CLIENT_ID: the iOS OAuth client ID for the direct Google Drive integration.
MARGINAL_ENTITLEMENTS =
GOOGLE_DRIVE_CLIENT_ID =

#include? "Local.xcconfig"
