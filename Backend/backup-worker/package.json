{
  "name": "tactile-backup-worker",
  "private": true,
  "version": "0.1.0",
  "description": "The Tactile Texts cloud backup service: checks a subscription and hands the app short-lived, scoped R2 credentials.",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy:production": "wrangler deploy --env production",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run",
    "prove": "node scripts/prove-scoped-credentials.ts",
    "prove:conditional": "node scripts/prove-conditional-writes.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.8.2",
    "@cloudflare/workers-types": "^5.20261115.1",
    "@peculiar/x509": "^3.1.0",
    "@types/node": "^24.19.2",
    "aws4fetch": "^1.0.20",
    "reflect-metadata": "^0.2.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.0",
    "wrangler": "^4.162.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261113.1": true,
    "fsevents": false
  }
}
