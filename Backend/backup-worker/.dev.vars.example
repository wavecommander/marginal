# Copy to .dev.vars (git-ignored) and fill in. Used by `wrangler dev` and by `npm run prove`.
# Use a DEVELOPMENT bucket and a token limited to it; never the production ones.
# Values here override the `vars` of the same name in wrangler.jsonc.

# The parent R2 API token: Object Read & Write, limited to the development bucket.
# R2 dashboard > Manage API Tokens. The Worker derives every short-lived credential from it and
# it never leaves the Worker.
R2_PARENT_ACCESS_KEY_ID=
R2_PARENT_SECRET_ACCESS_KEY=

# Any long random string (at least 32 characters, `openssl rand -hex 32`). Keys the hashes of
# sign-in identities and subscriptions, so no row can be worked back to an Apple or Google
# account or a purchase. Changing it loses every sign-in: set it once and keep it.
IDENTITY_KEY_SECRET=

# The app's Google OAuth client ID (iOS), to accept Google ID tokens. Several may be given,
# comma-separated. Empty: Google sign-in is off.
GOOGLE_CLIENT_IDS=

# Optional, both or neither: a Sign in with Apple key (Developer account > Keys), used only to
# revoke Apple authorizations when an account leaves Apple or is deleted. Without it, revocation
# is skipped with a log line. The private key is the .p8 file's contents; in this file write it
# on one line with its line breaks as \n, in double quotes.
APPLE_SIWA_KEY_ID=
APPLE_SIWA_PRIVATE_KEY=

# The account that owns the bucket (32 hex digits) and its S3 host. The Worker refuses to serve
# until both are set. For a purely local run, any 32 hex digits and `localhost:8787` will do.
R2_ACCOUNT_ID=
R2_S3_HOST=

# The 10-character App ID prefix (team ID). App Attest checks `<team ID>.<bundle ID>`; it is
# also the issuer of the Sign in with Apple client secret.
APPLE_TEAM_ID=

# Optional, `dev` only: lets the simulator (which has no App Attest) through when the app sends
# this value in the `X-App-Attest-Bypass` header. At least 32 characters. Never in production.
APP_ATTEST_BYPASS_SECRET=

# Optional, `dev` only: turns on the dev test issuer, so the simulator and the app's end-to-end
# test can sign in without Apple or Google by minting HS256 tokens keyed with this value (README,
# "The dev test issuer"). At least 32 characters (`openssl rand -hex 24`). Never in production:
# there, its mere presence stops the Worker.
DEV_TEST_SIGNIN_SECRET=

# Optional, `dev` only: base64 DER of Xcode's StoreKit test certificate, so purchases made with
# StoreKit Testing in Xcode are accepted (environment `Xcode`). Never in production.
XCODE_STOREKIT_CERT=

# Only the proof script reads this (the Worker takes it from wrangler.jsonc vars).
R2_BUCKET_NAME=tactile-texts-backups-dev
