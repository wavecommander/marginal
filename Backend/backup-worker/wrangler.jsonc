// The Tactile Texts cloud backup service.
//
// Two deployments:
// - the top level is `dev`: local development (`wrangler dev`) and a development deployment. It
//   accepts Xcode's local StoreKit test certificate and the App Attest bypass, so it must never
//   point at the production bucket.
// - `env.production`: Apple-signed subscriptions and real App Attest only.
//
// Secrets are never in this file. Local development reads them from `.dev.vars` (git-ignored,
// see `.dev.vars.example`); deployments get them from `wrangler secret put`:
//   R2_PARENT_ACCESS_KEY_ID, R2_PARENT_SECRET_ACCESS_KEY   the parent R2 token (object read and
//                                                          write on the one bucket)
//   USER_KEY_SECRET                                        keys the hash that names a user's folder
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tactile-backup-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    "ENVIRONMENT": "dev",
    // The Cloudflare account that owns the bucket, and the bucket's S3 endpoint host
    // (`<account id>.r2.cloudflarestorage.com`, or the jurisdiction form such as
    // `<account id>.eu.r2.cloudflarestorage.com`). Not secrets.
    "R2_ACCOUNT_ID": "",
    "R2_S3_HOST": "",
    "R2_BUCKET_NAME": "tactile-texts-backups-dev",
    "APP_BUNDLE_ID": "software.tactile.marginal",
    // Seconds a credential lasts. Short on purpose: it is a bearer token.
    "CREDENTIAL_TTL_SECONDS": "900",
    // After a subscription ends: days of read-only access, then the day the data is deleted.
    "READ_ONLY_DAYS": "30",
    "DELETE_AFTER_DAYS": "60",
    // Storage allowance in bytes for each backup product. Placeholders: the owner sets the
    // real product IDs and sizes.
    "PRODUCT_ALLOWANCES": "{\"software.tactile.marginal.backup.standard\": 10737418240}"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tactile-backup-dev",
      // Placeholder: local development needs no real ID. Replace it when the database exists.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "tactile-texts-backups-dev",
      // Serves the local bucket over S3 at /cdn-cgi/local/r2/s3 so the app's S3 client can be
      // pointed at `wrangler dev`. These values are arbitrary and open nothing real.
      "local_dev": {
        "experimental_s3_credentials": {
          "accessKeyId": "local-access-key-id",
          "secretAccessKey": "local-secret-access-key"
        }
      }
    }
  ],
  "env": {
    "production": {
      "name": "tactile-backup",
      "vars": {
        "ENVIRONMENT": "production",
        "R2_ACCOUNT_ID": "",
        "R2_S3_HOST": "",
        "R2_BUCKET_NAME": "tactile-texts-backups",
        "APP_BUNDLE_ID": "software.tactile.marginal",
        "CREDENTIAL_TTL_SECONDS": "900",
        "READ_ONLY_DAYS": "30",
        "DELETE_AFTER_DAYS": "60",
        "PRODUCT_ALLOWANCES": "{\"software.tactile.marginal.backup.standard\": 10737418240}"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tactile-backup",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "tactile-texts-backups" }]
    }
  }
}
