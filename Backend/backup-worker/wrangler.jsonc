// The Tactile Texts cloud backup service.
//
// Two deployments:
// - the top level is `dev`: local development (`wrangler dev`) and a development deployment. It
//   accepts Xcode's local StoreKit test certificate and the App Attest bypass, so it must never
//   point at the production bucket.
// - `env.production`: Apple-signed subscriptions and real App Attest only.
//
// Secrets are never in this file. Local development reads them from `.dev.vars` (git-ignored,
// see `.dev.vars.example`); deployments get them from `wrangler secret put`:
//   R2_PARENT_ACCESS_KEY_ID, R2_PARENT_SECRET_ACCESS_KEY   the parent R2 token (object read and
//                                                          write on the one bucket)
//   IDENTITY_KEY_SECRET                                    keys the hashes of sign-in identities and
//                                                          subscriptions (at least 32 characters; never change it)
//   APPLE_SIWA_KEY_ID, APPLE_SIWA_PRIVATE_KEY              optional, both or neither: the Sign in with Apple
//                                                          key, only to revoke Apple authorizations; without
//                                                          it revocation is skipped with a log line
//   APP_ATTEST_BYPASS_SECRET                               `dev` only, optional: lets the simulator
//                                                          through without App Attest. If it exists
//                                                          in production the Worker refuses to serve.
//   DEV_TEST_SIGNIN_SECRET                                 `dev` only, optional: the dev test issuer's
//                                                          key, so the simulator can sign in without
//                                                          Apple or Google. Same production refusal.
//
// The Worker makes outbound requests to four fixed addresses only: Apple's and Google's sign-in
// key sets, and Apple's token and revoke endpoints (see README, "Configuration").
//
// Every setting is checked when a request arrives (src/env.ts, readSettings); a missing or
// malformed one makes every endpoint, /v1/health included, answer 500 and log which setting.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tactile-backup-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    "ENVIRONMENT": "dev",
    // The Cloudflare account that owns the bucket, and the bucket's S3 endpoint host
    // (`<account id>.r2.cloudflarestorage.com`, or the jurisdiction form such as
    // `<account id>.eu.r2.cloudflarestorage.com`). Not secrets.
    "R2_ACCOUNT_ID": "",
    "R2_S3_HOST": "",
    "R2_BUCKET_NAME": "tactile-texts-backups-dev",
    "APP_BUNDLE_ID": "software.tactile.texts",
    // The 10-character App ID prefix (team ID) from the Apple Developer account. App Attest
    // checks `<team ID>.<bundle ID>`. Empty until the owner fills it in.
    "APPLE_TEAM_ID": "",
    // The app's numeric Apple ID in App Store Connect. Required in production; optional here.
    "APP_APPLE_ID": "",
    // Google OAuth client IDs (comma-separated) whose ID tokens are accepted: the app's iOS
    // client ID. Empty: Google sign-in is off. Not secrets.
    "GOOGLE_CLIENT_IDS": "",
    // Days before a subscription bought without the account's token may move to another account.
    "SUBSCRIPTION_MOVE_DAYS": "30",
    // Seconds a credential lasts. Short on purpose: it is a bearer token.
    "CREDENTIAL_TTL_SECONDS": "900",
    // After a subscription ends: days of read-only access, then the day the data is deleted.
    "READ_ONLY_DAYS": "30",
    "DELETE_AFTER_DAYS": "60",
    // Storage allowance in bytes for each backup product. Placeholders: the owner sets the
    // real product IDs and sizes.
    "PRODUCT_ALLOWANCES": "{\"software.tactile.texts.backup.standard\": 10737418240}",
    // Allowance for sandbox and Xcode purchases (App Review, TestFlight, development): 100 MB.
    "SANDBOX_ALLOWANCE_BYTES": "104857600",
    // Seconds a usage count is reused before the user's folder is listed again.
    "USAGE_CACHE_SECONDS": "300",
    // `dev` only: base64 DER of Xcode's StoreKit test certificate (open the .storekit file, then
    // Editor > Save Public Certificate; `base64 -i StoreKitTestCertificate.cer`). Empty: the
    // Xcode environment is refused. Never set in production (the Worker refuses to serve).
    "XCODE_STOREKIT_CERT": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tactile-backup-dev",
      // Placeholder: local development needs no real ID. Replace it when the database exists.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "tactile-texts-backups-dev",
      // Serves the local bucket over S3 at /cdn-cgi/local/r2/s3 so the app's S3 client can be
      // pointed at `wrangler dev`. These values are arbitrary and open nothing real.
      "local_dev": {
        "experimental_s3_credentials": {
          "accessKeyId": "local-access-key-id",
          "secretAccessKey": "local-secret-access-key"
        }
      }
    }
  ],
  "env": {
    "production": {
      "name": "tactile-backup",
      "vars": {
        "ENVIRONMENT": "production",
        "R2_ACCOUNT_ID": "",
        "R2_S3_HOST": "",
        "R2_BUCKET_NAME": "tactile-texts-backups",
        "APP_BUNDLE_ID": "software.tactile.texts",
        "APPLE_TEAM_ID": "",
        "APP_APPLE_ID": "",
        "GOOGLE_CLIENT_IDS": "",
        "SUBSCRIPTION_MOVE_DAYS": "30",
        "CREDENTIAL_TTL_SECONDS": "900",
        "READ_ONLY_DAYS": "30",
        "DELETE_AFTER_DAYS": "60",
        "PRODUCT_ALLOWANCES": "{\"software.tactile.texts.backup.standard\": 10737418240}",
        "SANDBOX_ALLOWANCE_BYTES": "104857600",
        "USAGE_CACHE_SECONDS": "300"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tactile-backup",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "tactile-texts-backups" }]
    }
  }
}
